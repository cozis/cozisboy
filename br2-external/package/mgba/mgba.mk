################################################################################
#
# mgba: libmgba only (the launcher links it directly)
#
################################################################################

MGBA_VERSION = 0.10.5
MGBA_SITE = $(call github,mgba-emu,mgba,$(MGBA_VERSION))
MGBA_LICENSE = MPL-2.0
MGBA_LICENSE_FILES = LICENSE
MGBA_INSTALL_STAGING = YES
MGBA_SUPPORTS_IN_SOURCE_BUILD = NO

MGBA_CONF_OPTS = \
	-DBUILD_SHARED=ON -DBUILD_STATIC=OFF \
	-DBUILD_QT=OFF -DBUILD_SDL=OFF -DBUILD_LIBRETRO=OFF -DBUILD_HEADLESS=OFF \
	-DBUILD_GL=OFF -DBUILD_GLES2=OFF -DBUILD_GLES3=OFF -DUSE_EPOXY=OFF \
	-DBUILD_PERF=OFF -DBUILD_TEST=OFF -DBUILD_SUITE=OFF -DBUILD_CINEMA=OFF \
	-DBUILD_EXAMPLE=OFF -DBUILD_UPDATER=OFF -DBUILD_ROM_TEST=OFF \
	-DUSE_FFMPEG=OFF -DUSE_ZLIB=OFF -DUSE_PNG=OFF -DUSE_LIBZIP=OFF \
	-DUSE_MINIZIP=OFF -DUSE_SQLITE3=OFF -DUSE_ELF=OFF -DUSE_LZMA=OFF \
	-DUSE_EDITLINE=OFF -DUSE_DISCORD_RPC=OFF -DUSE_LUA=OFF -DUSE_JSON_C=OFF \
	-DUSE_FREETYPE=OFF -DENABLE_SCRIPTING=OFF -DENABLE_DEBUGGERS=OFF \
	-DENABLE_GDB_STUB=OFF -DM_CORE_GBA=ON -DM_CORE_GB=ON -DSKIP_GIT=ON \
	-DCMAKE_POLICY_VERSION_MINIMUM=3.5

$(eval $(cmake-package))

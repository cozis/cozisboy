From 3abea18f3cde0b444f98d392a92097aa08833dc0 Mon Sep 17 00:00:00 2001
From: Francesco Cozzuto <francesco.cozzuto@gmail.com>
Date: Sat, 21 Nov 2026 12:56:29 +0100
Subject: [PATCH 21/21] arm64: dts: allwinner: rg35xx-sp: PWM backlight
 (brightness control)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HAivEfkKvP8urtyVqdwu3J
---
 .../allwinner/sun50i-h700-anbernic-rg35xx-sp.dts    | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
index ce184842f..091f0b5df 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
@@ -29,8 +29,11 @@ vibrator {
 	 * shows lit black.
 	 */
 	backlight: backlight {
-		compatible = "gpio-backlight";
-		gpios = <&pio 3 28 GPIO_ACTIVE_HIGH>; /* PD28, PWM0 on stock */
+		compatible = "pwm-backlight";
+		pwms = <&pwm 0 20000 0>;	/* PWM0 on PD28, 50 kHz as on stock */
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <160>;
 	};
 
 	reg_lcd: regulator-lcd-vdd {
@@ -127,3 +130,9 @@ &ehci0 {
 &ohci0 {
 	status = "disabled";
 };
+
+&pwm {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm0_pin>;
+	status = "okay";
+};

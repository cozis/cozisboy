From 607f973b1d89dccc4766392737b6d35321bd3121 Mon Sep 17 00:00:00 2001
From: Francesco Cozzuto <francesco.cozzuto@gmail.com>
Date: Sat, 21 Nov 2026 01:03:14 +0100
Subject: [PATCH 14/16] arm64: dts: allwinner: rg35xx-sp: backlight off at
 boot, owned by userspace

The panel used to switch the backlight on at modeset, showing lit black until
the boot splash drew. Let the splash enable it with its first frame instead.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HAivEfkKvP8urtyVqdwu3J
---
 .../boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts  | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
index af8aa6921..731bedf98 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
@@ -17,10 +17,14 @@ aliases {
 		mmc1 = &mmc1;
 	};
 
+	/*
+	 * Off at boot and not tied to the panel: userspace (the boot splash)
+	 * switches it on together with its first frame, so the screen never
+	 * shows lit black.
+	 */
 	backlight: backlight {
 		compatible = "gpio-backlight";
 		gpios = <&pio 3 28 GPIO_ACTIVE_HIGH>; /* PD28, PWM0 on stock */
-		default-on;
 	};
 
 	reg_lcd: regulator-lcd-vdd {
@@ -49,7 +53,6 @@ panel: panel@0 {
 			spi-3wire;
 			reset-gpios = <&pio 8 14 GPIO_ACTIVE_LOW>;	/* PI14 */
 			power-supply = <&reg_lcd>;
-			backlight = <&backlight>;
 			pinctrl-0 = <&lcd0_rgb888_pins>;
 			pinctrl-names = "default";
 

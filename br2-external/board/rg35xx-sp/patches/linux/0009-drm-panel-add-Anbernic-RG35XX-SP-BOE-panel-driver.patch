diff --git a/drivers/gpu/drm/panel/panel-anbernic-rg35xx-sp-boe.c b/drivers/gpu/drm/panel/panel-anbernic-rg35xx-sp-boe.c
new file mode 100644
index 000000000..9bfa89100
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-anbernic-rg35xx-sp-boe.c
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Driver for the BOE 3.5" 640x480 RGB panel fitted to some Anbernic
+ * RG35XX SP units (stock firmware: "fog_fj035fhd05_v1", lcd_type=boe).
+ *
+ * The panel is configured over a write-only 3-wire SPI bus using 9-bit
+ * words (D/C bit first), then streams pixels over parallel RGB.
+ * The register sequence was extracted from the stock vendor kernel; the
+ * controller is not otherwise documented.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/media-bus-format.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+#include <linux/spi/spi.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_mipi_dbi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+/*
+ * Encoded as: <data length>, <command>, <data...>
+ * 99 commands extracted from the stock Anbernic kernel (lcd_type=boe path).
+ */
+#include "panel-anbernic-rg35xx-sp-boe-seq.h"
+
+struct boe_panel {
+	struct drm_panel panel;
+	struct device *dev;
+	struct mipi_dbi dbi;
+	struct regulator *supply;
+	struct gpio_desc *reset_gpio;
+};
+
+static inline struct boe_panel *to_boe_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct boe_panel, panel);
+}
+
+static int boe_panel_send_seq(struct boe_panel *ctx)
+{
+	unsigned int i = 0;
+	int err;
+
+	while (i < ARRAY_SIZE(boe_init_seq)) {
+		u8 len = boe_init_seq[i];
+		u8 cmd = boe_init_seq[i + 1];
+
+		if (i + 2 + len > ARRAY_SIZE(boe_init_seq))
+			return -EINVAL;
+
+		err = mipi_dbi_command_buf(&ctx->dbi, cmd,
+					   (u8 *)&boe_init_seq[i + 2], len);
+		if (err) {
+			dev_err(ctx->dev, "command 0x%02x failed: %d\n", cmd, err);
+			return err;
+		}
+		i += 2 + len;
+	}
+
+	return 0;
+}
+
+static int boe_panel_prepare(struct drm_panel *panel)
+{
+	struct boe_panel *ctx = to_boe_panel(panel);
+	int err;
+
+	err = regulator_enable(ctx->supply);
+	if (err) {
+		dev_err(ctx->dev, "failed to enable power supply: %d\n", err);
+		return err;
+	}
+	/* Stock: 30 ms after power-on before touching the panel. */
+	msleep(30);
+
+	/* Stock reset pulse: release 15 ms, assert 50 ms, release 100 ms. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(15);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	msleep(50);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	msleep(100);
+
+	err = boe_panel_send_seq(ctx);
+	if (err)
+		goto err_power_off;
+
+	err = mipi_dbi_command(&ctx->dbi, MIPI_DCS_SET_ADDRESS_MODE, 0x00);
+	if (err)
+		goto err_power_off;
+
+	err = mipi_dbi_command(&ctx->dbi, MIPI_DCS_EXIT_SLEEP_MODE);
+	if (err)
+		goto err_power_off;
+	msleep(120);
+
+	return 0;
+
+err_power_off:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supply);
+	return err;
+}
+
+static int boe_panel_unprepare(struct drm_panel *panel)
+{
+	struct boe_panel *ctx = to_boe_panel(panel);
+	int err;
+
+	err = mipi_dbi_command(&ctx->dbi, MIPI_DCS_ENTER_SLEEP_MODE);
+	if (err)
+		dev_err(ctx->dev, "failed to enter sleep mode: %d\n", err);
+	msleep(5);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supply);
+
+	return 0;
+}
+
+static int boe_panel_enable(struct drm_panel *panel)
+{
+	struct boe_panel *ctx = to_boe_panel(panel);
+	int err;
+
+	err = mipi_dbi_command(&ctx->dbi, MIPI_DCS_SET_DISPLAY_ON);
+	if (err) {
+		dev_err(ctx->dev, "failed to turn display on: %d\n", err);
+		return err;
+	}
+	/* Stock waits 10 ms after display-on. */
+	msleep(10);
+
+	return 0;
+}
+
+static int boe_panel_disable(struct drm_panel *panel)
+{
+	struct boe_panel *ctx = to_boe_panel(panel);
+
+	return mipi_dbi_command(&ctx->dbi, MIPI_DCS_SET_DISPLAY_OFF);
+}
+
+/*
+ * Stock timings (Allwinner lcd0 node): dclk 24 MHz, ht 720, hbp 48 (incl.
+ * sync), hspw 8, vt 560, vbp 48 (incl. sync), vspw 4  ->  ~59.5 Hz.
+ * Stock hv_sync_polarity = 3 and hv_clk_phase = 2 map to PHSYNC|PVSYNC and
+ * DRM_BUS_FLAG_PIXDATA_DRIVE_NEGEDGE in the sun4i TCON driver.
+ */
+static const struct drm_display_mode boe_panel_mode = {
+	.clock		= 24000,
+	.hdisplay	= 640,
+	.hsync_start	= 640 + 32,
+	.hsync_end	= 640 + 32 + 8,
+	.htotal		= 720,
+	.vdisplay	= 480,
+	.vsync_start	= 480 + 32,
+	.vsync_end	= 480 + 32 + 4,
+	.vtotal		= 560,
+	.flags		= DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC,
+	.width_mm	= 70,
+	.height_mm	= 53,
+};
+
+static int boe_panel_get_modes(struct drm_panel *panel,
+			       struct drm_connector *connector)
+{
+	/* Stock enables TCON FRM dithering (lcd_frm = 1): an RGB666 panel. */
+	static const u32 bus_format = MEDIA_BUS_FMT_RGB666_1X18;
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &boe_panel_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.bpc = 6;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	connector->display_info.bus_flags = DRM_BUS_FLAG_PIXDATA_DRIVE_NEGEDGE;
+	drm_display_info_set_bus_formats(&connector->display_info,
+					 &bus_format, 1);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs boe_panel_funcs = {
+	.prepare	= boe_panel_prepare,
+	.unprepare	= boe_panel_unprepare,
+	.enable		= boe_panel_enable,
+	.disable	= boe_panel_disable,
+	.get_modes	= boe_panel_get_modes,
+};
+
+static int boe_panel_probe(struct spi_device *spi)
+{
+	struct device *dev = &spi->dev;
+	struct boe_panel *ctx;
+	int err;
+
+	ctx = devm_drm_panel_alloc(dev, struct boe_panel, panel,
+				   &boe_panel_funcs, DRM_MODE_CONNECTOR_DPI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dev = dev;
+
+	ctx->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->supply))
+		return dev_err_probe(dev, PTR_ERR(ctx->supply),
+				     "failed to get power supply\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	/* No D/C GPIO: 9-bit words with the D/C bit first. */
+	err = mipi_dbi_spi_init(spi, &ctx->dbi, NULL);
+	if (err)
+		return dev_err_probe(dev, err, "MIPI DBI init failed\n");
+
+	/* The bus is write-only. */
+	ctx->dbi.read_commands = NULL;
+
+	spi_set_drvdata(spi, ctx);
+
+	err = drm_panel_of_backlight(&ctx->panel);
+	if (err)
+		return dev_err_probe(dev, err, "failed to attach backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	return 0;
+}
+
+static void boe_panel_remove(struct spi_device *spi)
+{
+	struct boe_panel *ctx = spi_get_drvdata(spi);
+
+	drm_panel_remove(&ctx->panel);
+	drm_panel_disable(&ctx->panel);
+	drm_panel_unprepare(&ctx->panel);
+}
+
+static const struct of_device_id boe_panel_of_match[] = {
+	{ .compatible = "anbernic,rg35xx-sp-boe-panel" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, boe_panel_of_match);
+
+static const struct spi_device_id boe_panel_ids[] = {
+	{ "rg35xx-sp-boe-panel" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(spi, boe_panel_ids);
+
+static struct spi_driver boe_panel_driver = {
+	.driver = {
+		.name = "panel-anbernic-rg35xx-sp-boe",
+		.of_match_table = boe_panel_of_match,
+	},
+	.id_table = boe_panel_ids,
+	.probe = boe_panel_probe,
+	.remove = boe_panel_remove,
+};
+module_spi_driver(boe_panel_driver);
+
+MODULE_DESCRIPTION("BOE RGB panel driver for the Anbernic RG35XX SP");
+MODULE_LICENSE("GPL");

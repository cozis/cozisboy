From 81c293d8bd4147c6942a6bb5942960a994665fa1 Mon Sep 17 00:00:00 2001
From: Francesco Cozzuto <francesco.cozzuto@gmail.com>
Date: Fri, 20 Nov 2026 19:19:17 +0100
Subject: [PATCH 09/21] drm/panel: add Anbernic RG35XX SP BOE panel driver

Some RG35XX SP units ship a BOE 640x480 panel instead of the NV3052C one
(stock firmware selects it with lcd_type=boe). Init sequence, reset/power
timings, sync polarity, clock phase and dithering were extracted from the
stock vendor kernel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/Kconfig                 |  10 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../panel/panel-anbernic-rg35xx-sp-boe-seq.h  | 103 +++++++
 .../drm/panel/panel-anbernic-rg35xx-sp-boe.c  | 280 ++++++++++++++++++
 4 files changed, 394 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-anbernic-rg35xx-sp-boe-seq.h
 create mode 100644 drivers/gpu/drm/panel/panel-anbernic-rg35xx-sp-boe.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8f7..cc2f416dc 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -27,6 +27,16 @@ config DRM_PANEL_ANBERNIC_TD4310
 	  TD4310 panel controller such as the ones used on the Anbernic RG
 	  Vita Pro.
 
+config DRM_PANEL_ANBERNIC_RG35XX_SP_BOE
+	tristate "Anbernic RG35XX SP BOE RGB/SPI panel"
+	depends on OF && SPI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_MIPI_DBI
+	help
+	  Say Y here to enable support for the BOE 640x480 panel fitted to
+	  some Anbernic RG35XX SP handhelds (configured over 3-wire SPI,
+	  pixels over parallel RGB).
+
 config DRM_PANEL_ARM_VERSATILE
 	tristate "ARM Versatile panel driver"
 	depends on OF

From 949839407b3423822873c2af38fff874c7184fa1 Mon Sep 17 00:00:00 2001
From: Francesco Cozzuto <francesco.cozzuto@gmail.com>
Date: Fri, 20 Nov 2026 23:17:32 +0100
Subject: [PATCH 12/22] rg35xx-sp: fix BOE init values passed via register;
 keep USB PHY0 in device mode

- 8 of 102 panel commands had bytes the compiler passed as 'mov w0, w19'
  (w19 == 1 on the lcd_type=boe path); the first extraction reused stale
  values (gamma tables, a6/a8/a9/b8).
- Disable ehci0/ohci0: they call phy_set_mode(HOST) on the shared PHY 0 and
  take the port away from the MUSB gadget.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HAivEfkKvP8urtyVqdwu3J
---
 .../sun50i-h700-anbernic-rg35xx-sp.dts         | 12 ++++++++++++
 .../panel/panel-anbernic-rg35xx-sp-boe-seq.h   | 18 +++++++++---------
 2 files changed, 21 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
index 4b869a48c..807b0b2f5 100644
--- a/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
+++ b/arch/arm64/boot/dts/allwinner/sun50i-h700-anbernic-rg35xx-sp.dts
@@ -100,3 +100,15 @@ &reg_dcdc3 {
 	regulator-min-microvolt = <1200000>;
 	regulator-max-microvolt = <1200000>;
 };
+
+/*
+ * The USB-C port is used in device mode. EHCI0/OHCI0 share PHY 0 with the
+ * MUSB controller and switch it to host mode when they probe, so keep them off.
+ */
+&ehci0 {
+	status = "disabled";
+};
+
+&ohci0 {
+	status = "disabled";
+};

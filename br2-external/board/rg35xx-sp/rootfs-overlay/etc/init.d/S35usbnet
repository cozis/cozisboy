#!/bin/sh
# Ethernet over the USB-C cable (CDC-ECM gadget). Static addressing:
# device 10.55.0.2, PC 10.55.0.1 (NetworkManager profile 'ambernic-usb',
# matched by the fixed host MAC 02:a8:b0:00:00:01).
case "$1" in
start)
	ip link set usb0 up 2>/dev/null || exit 0
	ip addr add 10.55.0.2/24 dev usb0
	;;
stop)
	ip addr flush dev usb0 2>/dev/null
	;;
esac

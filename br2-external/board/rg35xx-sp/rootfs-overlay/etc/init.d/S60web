#!/bin/sh
# Web app (PC LINK in the launcher). Runs unless switched off there
# (/data/web-off); the launcher shows the pairing code.
case "$1" in
start)
	[ -f /data/web-off ] && exit 0
	mkdir -p /data/library
	setsid cozisboy-web 80 >/run/cozisboy-web.log 2>&1 </dev/null &
	;;
stop)
	killall cozisboy-web 2>/dev/null
	;;
restart)
	$0 stop; sleep 0.3; $0 start
	;;
esac

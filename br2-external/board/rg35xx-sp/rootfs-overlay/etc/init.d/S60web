#!/bin/sh
# Web app (prototype: started at boot until the launcher can switch it on and
# show the pairing code; meanwhile read it with: cat /run/cozisboy-web.code).
case "$1" in
start)
	mkdir -p /data/library
	setsid cozisboy-web 80 >/run/cozisboy-web.log 2>&1 </dev/null &
	;;
stop)
	killall cozisboy-web 2>/dev/null
	;;
restart)
	$0 stop; sleep 0.3; $0 start
	;;
esac

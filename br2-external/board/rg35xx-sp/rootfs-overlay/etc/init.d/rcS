#!/bin/sh
# Start all init scripts in /etc/init.d in numerical order, reporting boot
# progress to the splash (/run/splash.progress, 0..100) after each one.

set -- /etc/init.d/S??*
total=$#
n=0
for i in "$@"; do
	[ ! -f "$i" ] && continue
	"$i" start
	n=$((n + 1))
	echo $((n * 100 / total)) > /run/splash.progress
done

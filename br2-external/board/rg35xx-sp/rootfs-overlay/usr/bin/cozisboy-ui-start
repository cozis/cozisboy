#!/bin/sh
# Start the launcher (from inittab, respawned if it exits).
# Games, battery saves and save states come from the game library
# (/data/library, apps/common/library.h). /data/ui/saves keeps the launcher's
# own files: last-played.txt and the saves of extra copies (copies/).
mkdir -p /data/ui/saves /data/ui/thumbs
export COZ_SAVES=/data/ui/saves COZ_THUMBS=/data/ui/thumbs
exec /usr/bin/cozisboy-ui 2>>/run/cozisboy-ui.log

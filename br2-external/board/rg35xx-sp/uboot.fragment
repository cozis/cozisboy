# Boot immediately (Ctrl-C on serial still works during the check)
CONFIG_BOOTDELAY=0

# RG35XX SP has LPDDR3, not LPDDR4 like the RG35XX-2024/H this defconfig
# targets. Values taken from the stock boot0 dram_para (backup-stock,
# boot-region @ 8 KiB): type 7, 672 MHz. dx_odt/dx_dri/ca_dri/odt_en/tpr6
# match the other H616 LPDDR3 board in U-Boot (tanix_tx1).
# CONFIG_SUNXI_DRAM_H616_LPDDR4 is not set
CONFIG_SUNXI_DRAM_H616_LPDDR3=y
CONFIG_DRAM_CLK=672
CONFIG_DRAM_SUNXI_DX_ODT=0x06060606
CONFIG_DRAM_SUNXI_DX_DRI=0x0d0d0d0d
CONFIG_DRAM_SUNXI_CA_DRI=0x1919
CONFIG_DRAM_SUNXI_ODT_EN=0x9988eeee
CONFIG_DRAM_SUNXI_TPR2=0x1
CONFIG_DRAM_SUNXI_TPR6=0x2fb08080
CONFIG_DRAM_SUNXI_TPR10=0x402f4489
CONFIG_DRAM_SUNXI_TPR11=0x0e111112
CONFIG_DRAM_SUNXI_TPR12=0x0d0e0d0f
CONFIG_DRAM_SUNXI_PHY_ADDR_MAP_1=y

# LPDDR3 runs at 1.2 V (the RG35XX-2024 defconfig sets 1.1 V for LPDDR4).
# At 1.1 V DRAM training passes but code running from DRAM crashes.
CONFIG_AXP_DCDC3_VOLT=1200

# Do not let U-Boot feed the watchdog: a FEL-armed watchdog must be able to reset a stuck U-Boot
# CONFIG_WATCHDOG_AUTOSTART is not set

# Use the SP device tree (TF-A programs the PMIC from it)
CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun50i-h700-anbernic-rg35xx-sp"
CONFIG_OF_LIST="allwinner/sun50i-h700-anbernic-rg35xx-sp"

# USB disk mode: hold M (PE3, active low) at power-on -> the SD card is
# exported to the PC as a USB mass-storage device (Ctrl-C / unplug to continue).
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_FUNCTION_MASS_STORAGE=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="if gpio input PE3; then echo USB disk mode; ums 0 mmc 0; fi"

# ---- Fast boot ----
# No saved environment: the card has no FAT partition to search.
# CONFIG_ENV_IS_IN_FAT is not set
CONFIG_ENV_IS_NOWHERE=y
# Timestamps of each boot step, passed to Linux in /proc/device-tree/bootstage
CONFIG_BOOTSTAGE=y
CONFIG_BOOTSTAGE_FDT=y
# Direct boot: fixed paths, LZ4 kernel, no device/partition scanning.
CONFIG_BOOTCOMMAND="setenv bootargs root=/dev/mmcblk0p1 rootwait rootfstype=ext4 init=/sbin/preinit console=ttyS0,115200 quiet loglevel=3 logo.nologo vt.global_cursor_default=0 g_ether.dev_addr=02:a8:b0:00:00:02 g_ether.host_addr=02:a8:b0:00:00:01; load mmc 0:1 ${fdt_addr_r} /boot/allwinner/sun50i-h700-anbernic-rg35xx-sp.dtb; load mmc 0:1 ${kernel_addr_r} /boot/Image.lz4; setenv kernel_comp_addr_r 0x44000000; setenv kernel_comp_size ${filesize}; booti ${kernel_addr_r} - ${fdt_addr_r}; run distro_bootcmd"

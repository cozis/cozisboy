# Identify our kernel
CONFIG_LOCALVERSION="-ambernic"
# USB-C in device mode: ethernet gadget (CDC ECM + RNDIS) built in, for SSH over cable
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# Keep crash logs across warm reboots (needs a reserved-memory node, added later)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Boot-time measurement
CONFIG_PRINTK_TIME=y
# Display: DE33 mixer -> TCON-TOP -> TCON LCD0 -> BOE panel (gpio SPI), built in
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_ANBERNIC_RG35XX_SP_BOE=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_FRAMEBUFFER_CONSOLE=y

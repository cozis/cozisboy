# Identify our kernel
CONFIG_LOCALVERSION="-ambernic"
# USB-C in device mode: CDC-ECM ethernet gadget built in, for SSH over cable.
# No RNDIS: its product ID (0525:a4a2) lets the PC's cdc_subset driver grab the port.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
# CONFIG_USB_ETH_RNDIS is not set
# Keep crash logs across warm reboots (needs a reserved-memory node, added later)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Boot-time measurement
CONFIG_PRINTK_TIME=y
# Display: DE33 mixer -> TCON-TOP -> TCON LCD0 -> BOE panel (gpio SPI), built in
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_ANBERNIC_RG35XX_SP_BOE=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Watchdog built in: keeps the FEL-armed watchdog fed once Linux runs
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y

# ---- Boot-time trim: only Allwinner, nothing this handheld can't use ----
# Other SoC families (their drivers depend on these and disappear with them)

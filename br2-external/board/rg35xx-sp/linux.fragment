# Identify our kernel
CONFIG_LOCALVERSION="-ambernic"
# USB-C in device mode: CDC-ECM ethernet gadget built in, for SSH over cable.
# No RNDIS: its product ID (0525:a4a2) lets the PC's cdc_subset driver grab the port.
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
# CONFIG_USB_ETH_RNDIS is not set
# Keep crash logs across warm reboots (needs a reserved-memory node, added later)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Boot-time measurement
CONFIG_PRINTK_TIME=y
# Display: DE33 mixer -> TCON-TOP -> TCON LCD0 -> BOE panel (gpio SPI), built in
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_ANBERNIC_RG35XX_SP_BOE=y
CONFIG_SPI=y
CONFIG_SPI_GPIO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Watchdog built in: keeps the FEL-armed watchdog fed once Linux runs
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y

# ---- Boot-time trim: only Allwinner, nothing this handheld can't use ----
# Other SoC families (their drivers depend on these and disappear with them)
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Buses / platforms / features with no hardware here
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_NVME_CORE is not set
# CONFIG_MTD is not set
# CONFIG_INFINIBAND is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_STAGING is not set
# CONFIG_ETHERNET is not set
# CONFIG_NET_VENDOR_ATHEROS is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_DWC2 is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_USB_CHIPIDEA is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_SERIO is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TABLET is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# Later / optional hardware as modules (not loaded during boot)
CONFIG_DRM_PANFROST=m
CONFIG_SUN8I_CE=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CS=m
# Server/desktop/container features with no use on a handheld
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_PROFILING is not set
# CONFIG_NUMA is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_NETFILTER is not set
# CONFIG_IPV6 is not set
# CONFIG_QUOTA is not set
# CONFIG_FANOTIFY is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_EFI is not set
# CONFIG_IKCONFIG is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IO_URING is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_NET_9P is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_MPTCP is not set
# ---- Pass 3: generic drivers with no hardware here, size-optimised build ----
# Smaller code loads faster than it runs slower on this boot path.
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# No KASLR: no relocation tables to carry or process at boot
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_RELOCATABLE is not set
# Virtual-machine / server platform pieces
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_ARM_SMMU is not set
# CONFIG_ARM_SMMU_V3 is not set
# CONFIG_PHYLIB is not set
# CONFIG_NET_DEVLINK is not set
# No USB host on this build: no HID devices to drive
# CONFIG_HID is not set
# CONFIG_HID_DEBUG is not set
# PMIC/regulator drivers for other boards (keep AXP20x, fixed, GPIO)
# CONFIG_REGULATOR_S2MPS11 is not set
# CONFIG_MFD_SEC_CORE is not set
# CONFIG_REGULATOR_PCA9450 is not set
# CONFIG_REGULATOR_PF8X00 is not set
# CONFIG_REGULATOR_PFUZE100 is not set
# CONFIG_REGULATOR_RK808 is not set
# CONFIG_MFD_RK8XX_I2C is not set
# CONFIG_REGULATOR_MAX77620 is not set
# CONFIG_REGULATOR_FAN53555 is not set
# CONFIG_REGULATOR_PWM is not set
# CONFIG_REGULATOR_VCTRL is not set
# Nothing but our splash/UI may draw on the screen: no text console, no logo.
# Kernel messages: SSH (dmesg) or the serial port.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# Audio built in, so the boot jingle can start together with the splash
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SUN4I_CODEC=y
CONFIG_DMA_SUN6I=y
# GPU power domain (PRCM PPU) - without it Panfrost never gets its power domain
CONFIG_SUN50I_H6_PRCM_PPU=y
# Wi-Fi pwrseq: with RESET_GPIO enabled (=m or =y) pwrseq_simple routes its
# single reset-gpios through the reset framework, whose GPIO fallback only
# supports #gpio-cells = 2 and fails with -ENOENT on Allwinner's 3-cell GPIOs.
# Disabled, pwrseq_simple drives the GPIO directly.
# CONFIG_RESET_GPIO is not set
